# ===========================================
# AI Product Research Assistant Configuration
# ===========================================

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
COLLECTION_NAME=products

# Ollama LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Embedding Model (Sentence Transformers - runs locally, no API key needed)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Database (SQLite by default)
DATABASE_URL=sqlite:///./data/app.db

# Web Search API Keys (optional - uses mock data if not provided)
# Get Tavily API key at: https://tavily.com/
TAVILY_API_KEY=

# Get Serper API key at: https://serper.dev/
SERPER_API_KEY=

# ===========================================
# Docker Configuration (used in docker-compose)
# ===========================================
# When running in Docker, these are typically overridden:
# QDRANT_HOST=qdrant
# OLLAMA_BASE_URL=http://ollama:11434
